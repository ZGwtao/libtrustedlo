#include "pancake_args.h"

#define PROTOCON_IMAGE_MAGIC       1346586957
#define PROTOCON_MKTSYMB_OFFSET    8
#define PROTOCON_ELF_OFFSET        24

inline fun pancake_arg(1 index)
{
    var value = lds 1 (@base + index * @biw);
    return value;
}

fun mktxlo_memcmp(1 lhs, 1 rhs, 1 length)
{
    var error = 0 - 1;
    var index = 0;
    var lhs_byte = 0;
    var rhs_byte = 0;

    /* Compare byte by byte */
    while (index < length) {
        !ld8 lhs_byte, lhs + index;
        !ld8 rhs_byte, rhs + index;
        /* If values not equal, exit */
        if (lhs_byte != rhs_byte) {
            return error;
        }
        /* Check next byte */
        index = index + 1;
    }
    return 0;
}

inline fun mktxlo_client_image_region(1 image, 1 offset_field)
{
    var offset = 0;
    !ldw offset, image + offset_field;
    var region = image + offset;
    return region;
}

inline fun mktxlo_client_image_mktsymb(1 image)
{
    return mktxlo_client_image_region(image, PROTOCON_MKTSYMB_OFFSET);
}

inline fun mktxlo_client_image_elf(1 image)
{
    return mktxlo_client_image_region(image, PROTOCON_ELF_OFFSET);
}

fun mktxlo_client_image_check_magic(1 image)
{
    var error = 0 - 1;
    /* Check payload image magic */
    var magic = 0;
    !ld32 magic, image;
    if (magic != PROTOCON_IMAGE_MAGIC) {
        return error;
    }
    return 0;
}

fun mktxlo_payload_check_mktsymb(1 mktsymb)
{
    var magic_addr = pancake_arg(PNK_ARG_MKS_MAGIC);
    return mktxlo_memcmp(mktsymb, magic_addr, MKS_MAGIC_SIZE);
}

fun mktxlo_payload_check_elf_magic(1 elf)
{
    var magic_addr = pancake_arg(PNK_ARG_ELF_MAGIC);
    return mktxlo_memcmp(elf, magic_addr, ELF_MAGIC_SIZE);
}

fun mktxlo_client_image_check_integrity(1 image)
{

    var r = mktxlo_client_image_check_magic(image);
    if (r != 0) {
        return r;
    }

    /* Check Microkit Symbol magic */
    var mktsymb = mktxlo_client_image_mktsymb(image);

    r = mktxlo_payload_check_mktsymb(mktsymb);
    if (r != 0) {
        return r;
    }

    /* Check executable's magic */
    var elf = mktxlo_client_image_elf(image);

    r = mktxlo_payload_check_elf_magic(elf);
    if (r != 0) {
        return r;
    }

    return 0;
}

fun mktxlo_self_load_entry_pancake()
{
    var client_image = pancake_arg(PNK_ARG_CLIENT_IMAGE);
    var trampo_image = pancake_arg(PNK_ARG_TRAMPO_IMAGE);

    var r =
        mktxlo_client_image_check_integrity(client_image);
    /* If r != 0, ffi stops going into the C self-ld */
    if (r == 0) {
        r = mktxlo_payload_check_elf_magic(trampo_image);
    }
    /* The remaining self-load path is still implemented in C. */
    @mktxlo_self_load_continue(0, r, 0, 0);
    return 0;
}

fun main()
{
    return mktxlo_self_load_entry_pancake();
}
