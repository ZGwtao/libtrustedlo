#define PROTOCON_ELF_SIZE          32

#define ELF_ENTRY_OFFSET            24
#define ELF_PHOFF_OFFSET            32
#define ELF_PHENTSIZE_OFFSET        54
#define ELF_PHNUM_OFFSET            56
#define ELF_PHDR_SIZE               56

#define ELF_PHDR_TYPE_OFFSET        0
#define ELF_PHDR_FILE_OFFSET        8
#define ELF_PHDR_VADDR_OFFSET       16
#define ELF_PHDR_FILESZ_OFFSET      32
#define ELF_PHDR_MEMSZ_OFFSET       40
#define ELF_PT_LOAD                 1

#define ELF_SHOFF_OFFSET            40
#define ELF_SHENTSIZE_OFFSET        58
#define ELF_SHNUM_OFFSET            60
#define ELF_SH_TYPE_OFFSET          4
#define ELF_SH_OFFSET_OFFSET        24
#define ELF_SH_SIZE_OFFSET          32
#define ELF_SH_LINK_OFFSET          40
#define ELF_SHT_SYMTAB              2
#define ELF_SYM_SIZE                24
#define ELF_SYM_NAME_OFFSET         0
#define ELF_SYM_VALUE_OFFSET        8

inline fun mktxlo_elf_name_equal(1 lhs, 1 rhs, 1 length)
{
    var result = mktxlo_memcmp(lhs, rhs, length);
    if (result != 0) {
        return 0;
    }
    var terminator = 0;
    !ld8 terminator, lhs + length;
    if (terminator != 0) {
        return 0;
    }
    return 1;
}

inline fun mktxlo_elf_symbol_name(1 strtab, 1 symbol)
{
    var name_offset = 0;
    !ld32 name_offset, symbol + ELF_SYM_NAME_OFFSET;
    return strtab + name_offset;
}

inline fun mktxlo_elf_symbol_value(1 symbol)
{
    var value = 0;
    !ldw value, symbol + ELF_SYM_VALUE_OFFSET;
    return value;
}

inline fun mktxlo_elf_shoff(1 elf)
{
    var value = 0;
    !ldw value, elf + ELF_SHOFF_OFFSET;
    return value;
}

inline fun mktxlo_elf_shentsize(1 elf)
{
    var value = 0;
    !ld16 value, elf + ELF_SHENTSIZE_OFFSET;
    return value;
}

inline fun mktxlo_elf_shnum(1 elf)
{
    var value = 0;
    !ld16 value, elf + ELF_SHNUM_OFFSET;
    return value;
}

inline fun mktxlo_elf_shdr(1 elf, 1 shoff, 1 shentsize, 1 index)
{
    return elf + shoff + index * shentsize;
}

inline fun mktxlo_elf_sh_type(1 shdr)
{
    var value = 0;
    !ld32 value, shdr + ELF_SH_TYPE_OFFSET;
    return value;
}

inline fun mktxlo_elf_sh_offset(1 shdr)
{
    var value = 0;
    !ldw value, shdr + ELF_SH_OFFSET_OFFSET;
    return value;
}

inline fun mktxlo_elf_sh_size(1 shdr)
{
    var value = 0;
    !ldw value, shdr + ELF_SH_SIZE_OFFSET;
    return value;
}

inline fun mktxlo_elf_sh_link(1 shdr)
{
    var value = 0;
    !ld32 value, shdr + ELF_SH_LINK_OFFSET;
    return value;
}

inline fun mktxlo_elf_symtab_symbol(1 elf, 1 symoff, 1 sym_offset)
{
    return elf + symoff + sym_offset;
}

inline fun mktxlo_elf_find_symtab_symbol(1 elf, 1 symoff, 1 symsz,
                                         1 strtab, 1 name, 1 name_len)
{
    var sym_offset = 0;
    while (sym_offset < symsz) {
        var symbol = mktxlo_elf_symtab_symbol(elf, symoff, sym_offset);
        var sym_name = mktxlo_elf_symbol_name(elf + strtab, symbol);
        var equal = mktxlo_elf_name_equal(sym_name, name, name_len);
        if (equal != 0) {
            return mktxlo_elf_symbol_value(symbol);
        }
        sym_offset = sym_offset + ELF_SYM_SIZE;
    }
    return 0;
}

inline fun mktxlo_elf_find_symbol(1 elf, 1 name, 1 name_len)
{
    var shoff = mktxlo_elf_shoff(elf);
    var shentsize = mktxlo_elf_shentsize(elf);
    var shnum = mktxlo_elf_shnum(elf);

    var section_index = 0;
    while (section_index < shnum) {
        var shdr = mktxlo_elf_shdr(elf, shoff, shentsize, section_index);
        var sh_type = mktxlo_elf_sh_type(shdr);
        if (sh_type == ELF_SHT_SYMTAB) {
            var symoff = mktxlo_elf_sh_offset(shdr);
            var symsz = mktxlo_elf_sh_size(shdr);
            var str_index = mktxlo_elf_sh_link(shdr);

            var strhdr = mktxlo_elf_shdr(elf, shoff, shentsize, str_index);
            var strtab = mktxlo_elf_sh_offset(strhdr);
            var value = mktxlo_elf_find_symtab_symbol(elf, symoff, symsz,
                                                      strtab, name, name_len);
            if (value != 0) {
                return value;
            }
        }
        section_index = section_index + 1;
    }
    return 0;
}

inline fun mktxlo_elf_check_entry(1 elf, 1 load_vaddr, 1 load_size)
{
    var error = -1;
    var entry = 0;
    !ldw entry, elf + ELF_ENTRY_OFFSET;
    if (entry < load_vaddr || entry - load_vaddr >= load_size) {
        return error;
    }
    return 0;
}

inline fun mktxlo_elf_check_phdr_table(1 elf, 1 elf_size)
{
    var error = -1;
    var phentsize = mktxlo_elf_phentsize(elf);
    if (phentsize != ELF_PHDR_SIZE) {
        return error;
    }

    var phoff = mktxlo_elf_phoff(elf);
    var phnum = mktxlo_elf_phnum(elf);
    var result = mktxlo_elf_check_phdr_range(phoff, phnum, elf_size);
    if (result != 0) {
        return error;
    }
    return 0;
}

inline fun mktxlo_elf_phoff(1 elf)
{
    var phoff = 0;
    !ldw phoff, elf + ELF_PHOFF_OFFSET;
    return phoff;
}

inline fun mktxlo_elf_phentsize(1 elf)
{
    var phentsize = 0;
    !ld16 phentsize, elf + ELF_PHENTSIZE_OFFSET;
    return phentsize;
}

inline fun mktxlo_elf_phnum(1 elf)
{
    var phnum = 0;
    !ld16 phnum, elf + ELF_PHNUM_OFFSET;
    return phnum;
}

inline fun mktxlo_elf_phdr(1 elf, 1 phoff, 1 index)
{
    return elf + phoff + index * ELF_PHDR_SIZE;
}

inline fun mktxlo_elf_check_phdr_range(1 phoff, 1 phnum, 1 elf_size)
{
    var error = -1;
    /* phnum is a 16-bit ELF field, so this multiplication cannot overflow. */
    if (phoff > elf_size || phnum * ELF_PHDR_SIZE > elf_size - phoff) {
        return error;
    }
    return 0;
}

inline fun mktxlo_elf_phdr_type(1 phdr)
{
    var type = 0;
    !ld32 type, phdr + ELF_PHDR_TYPE_OFFSET;
    return type;
}

inline fun mktxlo_elf_phdr_file_offset(1 phdr)
{
    var value = 0;
    !ldw value, phdr + ELF_PHDR_FILE_OFFSET;
    return value;
}

inline fun mktxlo_elf_phdr_vaddr(1 phdr)
{
    var value = 0;
    !ldw value, phdr + ELF_PHDR_VADDR_OFFSET;
    return value;
}

inline fun mktxlo_elf_phdr_filesz(1 phdr)
{
    var value = 0;
    !ldw value, phdr + ELF_PHDR_FILESZ_OFFSET;
    return value;
}

inline fun mktxlo_elf_phdr_memsz(1 phdr)
{
    var value = 0;
    !ldw value, phdr + ELF_PHDR_MEMSZ_OFFSET;
    return value;
}

inline fun mktxlo_elf_check_file_range(1 file_offset, 1 filesz, 1 elf_size)
{
    var error = -1;
    if (file_offset > elf_size || filesz > elf_size - file_offset) {
        return error;
    }
    return 0;
}

inline fun mktxlo_elf_check_seg_range(1 vaddr, 1 memsz,
                                      1 load_vaddr, 1 load_size)
{
    var error = -1;
    if (vaddr < load_vaddr) {
        return error;
    }
    var seg_offset = vaddr - load_vaddr;
    if (seg_offset > load_size || memsz > load_size - seg_offset) {
        return error;
    }
    return 0;
}

inline fun mktxlo_elf_seg_offset(1 vaddr, 1 load_vaddr)
{
    return vaddr - load_vaddr;
}

inline fun mktxlo_elf_load_segment(1 elf, 1 file_offset, 1 filesz,
                                   1 load_base, 1 seg_offset, 1 memsz)
{
    var dest = load_base + seg_offset;
    mktxlo_memcpy(dest, elf + file_offset, filesz);
    mktxlo_memzero(dest + filesz, memsz - filesz);
    return 0;
}

inline fun mktxlo_elf_load_phdr(1 elf, 1 phdr, 1 elf_size, 1 load_base,
                                1 load_vaddr, 1 load_size)
{
    var error = -1;
    var type = mktxlo_elf_phdr_type(phdr);
    if (type != ELF_PT_LOAD) {
        return 0;
    }

    var file_offset = mktxlo_elf_phdr_file_offset(phdr);
    var vaddr = mktxlo_elf_phdr_vaddr(phdr);
    var filesz = mktxlo_elf_phdr_filesz(phdr);
    var memsz = mktxlo_elf_phdr_memsz(phdr);
    if (filesz > memsz) {
        return error;
    }

    var result = mktxlo_elf_check_file_range(file_offset, filesz, elf_size);
    if (result != 0) {
        return error;
    }
    result = mktxlo_elf_check_seg_range(vaddr, memsz, load_vaddr, load_size);
    if (result != 0) {
        return error;
    }

    var seg_offset = mktxlo_elf_seg_offset(vaddr, load_vaddr);
    return mktxlo_elf_load_segment(elf, file_offset, filesz, load_base,
                                   seg_offset, memsz);
}

inline fun mktxlo_elf_load_phdrs(1 elf, 1 elf_size, 1 load_base,
                                 1 load_vaddr, 1 load_size)
{
    var error = -1;
    var phoff = mktxlo_elf_phoff(elf);
    var phnum = mktxlo_elf_phnum(elf);

    var index = 0;
    while (index < phnum) {
        var phdr = mktxlo_elf_phdr(elf, phoff, index);
        var result = mktxlo_elf_load_phdr(elf, phdr, elf_size, load_base,
                                          load_vaddr, load_size);
        if (result != 0) {
            return error;
        }
        index = index + 1;
    }
    return 0;
}

/* Load PT_LOAD segments into the loader's mapping of the target region. */
fun mktxlo_payload_load(1 elf, 1 elf_size, 1 load_base, 1 load_vaddr, 1 load_size)
{
    var error = -1;
    var result = mktxlo_elf_check_entry(elf, load_vaddr, load_size);
    if (result != 0) {
        return error;
    }
    result = mktxlo_elf_check_phdr_table(elf, elf_size);
    if (result != 0) {
        return error;
    }

    result = mktxlo_elf_load_phdrs(elf, elf_size, load_base, load_vaddr, load_size);
    if (result != 0) {
        return error;
    }
    return 0;
}
